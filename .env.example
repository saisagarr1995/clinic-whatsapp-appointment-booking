# Copy to .env and fill in. NEVER commit .env.
# `python setup.py` writes this file for you — you should not need to edit it by hand.

# --- Meta WhatsApp Cloud API ---
# developers.facebook.com -> your app -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

# App secret: Settings -> Basic -> App Secret. Used to verify webhook signatures.
WHATSAPP_APP_SECRET=

# Any random string you invent. Paste the SAME value into the Meta webhook config.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
WHATSAPP_VERIFY_TOKEN=

# Graph API version.
WHATSAPP_API_VERSION=v21.0

# --- Public URL ---
# Your cloudflared/ngrok/production HTTPS base URL, no trailing slash.
# The UPI QR image and payment page are served from here, so it must be
# reachable from the patient's phone.
PUBLIC_BASE_URL=https://example.trycloudflare.com

# --- Local ---
DATABASE_URL=sqlite:///data/clinic.db
CLINIC_CONFIG_PATH=config/clinic.yaml
# Keep this on localhost. Caddy terminates TLS and proxies inward; the app
# should never listen on a public interface directly.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
