# Groups every clinic instance so the whole fleet can be controlled at once.
#
#   sudo systemctl restart clinic-bot.target    # restart every clinic
#   sudo systemctl stop clinic-bot.target       # stop the fleet
#
# Individual clinics remain independently controllable; this is a convenience
# layer, not a coupling. One clinic failing never stops the others.

[Unit]
Description=All clinic WhatsApp bot instances
After=network-online.target

[Install]
WantedBy=multi-user.target
