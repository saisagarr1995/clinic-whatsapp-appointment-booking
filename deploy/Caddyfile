# Caddy reverse proxy for the whole clinic fleet.
#
# Caddy obtains and renews a Let's Encrypt certificate automatically. Meta
# requires a publicly trusted certificate on the webhook URL; this provides one
# free, with no manual renewal to forget.
#
# ROUTING (changed 2026-07-26 — PROJECT_PLAN.md D13 amended)
# One process now serves the whole fleet and resolves the clinic from the URL
# itself, so the /c/<slug>/ prefix must be passed through UNCHANGED. Caddy no
# longer strips it and there is no longer one upstream port per clinic.
# One certificate covers every clinic — no wildcard DNS required.
#
# NOTE: deploy/fleet.sh and deploy/clinic-bot@.service still describe the older
# process-per-clinic model and have NOT been reworked for this change. They must
# be updated before this Caddyfile is used on the VM.
#
# Install:
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo sed -i 's/bot.example.duckdns.org/YOUR-DOMAIN/' /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

{
	# Contact address for Let's Encrypt expiry warnings.
	email admin@example.com

	# Do not advertise the server software.
	servers {
		trusted_proxies static private_ranges
	}
}

bot.example.duckdns.org {

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# Payment pages are per-booking and must never be indexed.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Every clinic path goes to the single fleet process, prefix intact.
	# The app 404s an unknown slug itself, so no per-clinic config is needed here.
	handle /c/* {
		reverse_proxy 127.0.0.1:8000
	}

	# Fleet-wide health check for uptime monitoring. Deliberately generic: it
	# must not reveal which clinics exist on this server.
	handle /health {
		respond "ok" 200
	}

	# Anything outside a configured clinic path is not part of this product.
	handle {
		respond "Not found" 404
	}

	log {
		output file /var/log/caddy/clinic-fleet.log {
			roll_size 20MiB
			roll_keep 10
		}
		# Webhook bodies carry patient phone numbers; log metadata only.
		format json
	}
}
