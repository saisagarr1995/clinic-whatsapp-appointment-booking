# --- Secrets. Never commit these. ---
.env
.env.*
!.env.example
*.pem
*.key

# Per-clinic Meta credentials. The template and the README are the only files
# in config/secrets/ that may ever be committed.
config/secrets/*.env
!config/secrets/example.env.template

# --- The single-prompt rebuild file. Explicitly excluded from GitHub. ---
RECREATE_PROMPT.md

# --- Local clinic data & runtime state ---
*.db
*.db-journal
*.sqlite
*.sqlite3
data/
setup_state.json

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# --- Stray screenshots and pasted images dropped in the repo root ---
# Only the root is ignored; templates and docs may still carry real assets.
/*.png
/*.jpg
/*.jpeg
/*.gif

# --- Editors / OS ---
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
