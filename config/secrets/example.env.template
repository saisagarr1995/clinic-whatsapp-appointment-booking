# Copy to config/secrets/<slug>.env and fill in. NEVER commit the copy.
# developers.facebook.com -> your app -> WhatsApp -> API Setup

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Settings -> Basic -> App Secret. Verifies webhook signatures for THIS clinic.
WHATSAPP_APP_SECRET=

# Any random string you invent. Paste the SAME value into the Meta webhook config.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
WHATSAPP_VERIFY_TOKEN=

WHATSAPP_API_VERSION=v21.0
