# Normalise line endings.
#
# The developer works on Windows; the server runs Linux. A shell script or a
# systemd unit checked out with CRLF fails on the server — a script errors with
# "bad interpreter: /usr/bin/env bash^M" and a unit file silently misparses.
# These MUST stay LF regardless of the platform they are checked out on.

* text=auto eol=lf

*.sh            text eol=lf
*.service       text eol=lf
*.target        text eol=lf
Caddyfile       text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.py            text eol=lf
*.toml          text eol=lf
*.md            text eol=lf
.env.example    text eol=lf

# Binary — never touch these.
*.png           binary
*.jpg           binary
*.ico           binary
*.db            binary
*.gz            binary
